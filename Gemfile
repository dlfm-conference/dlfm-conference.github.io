source "https://rubygems.org"

# Pin to the github-pages gem so local builds match GitHub's default Pages
# builder exactly (Jekyll + supported plugin versions). This lets the site
# deploy with zero CI configuration.
gem "github-pages", "~> 227", group: :jekyll_plugins

# Required for `jekyll serve` on Ruby 3+ (webrick left the stdlib).
gem "webrick", "~> 1.8"
