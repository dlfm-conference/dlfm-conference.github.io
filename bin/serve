#!/usr/bin/env bash
# Local preview wrapper for the DLfM site.
#
# `bundle exec jekyll serve` works on its own once a shell is set up for it.
# This wrapper exists because on a stock macOS that setup is the exception,
# not the rule, and both of the gaps are silent until they aren't:
#
#   * Ruby. macOS ships 2.6, too old for the gems this site pins, and
#     /etc/paths.d/homebrew is APPENDED after /usr/bin by path_helper — so a
#     plain `bundle` picks the system Ruby even when a modern one is installed,
#     and fails resolving the Gemfile. We put a Ruby >= 3 in front first.
#   * Locale. A macOS shell often starts with no LANG at all, and Jekyll's SCSS
#     converter then dies on the first non-ASCII byte in the stylesheet
#     (`Invalid US-ASCII character "\xE2"`). We set one if nothing else has.
#
# Neither is specific to one machine, so this is a convenience rather than a
# workaround: it pins the two things a local build needs and otherwise hands
# straight over to bundler. If your shell already handles both, calling
# `bundle exec jekyll …` directly does exactly the same thing.
#
# Usage:
#   bin/serve                 # serve at http://127.0.0.1:4000
#   bin/serve --port 5000     # serve on another port
#   bin/serve build           # one-off build into _site/
#   bin/serve build --profile # any jekyll subcommand + flags pass through
#
# Run in the foreground (Ctrl-C to stop); `--detach` misbehaves here.
# Fallback if `serve` ever hangs:
#   bin/serve build && python3 -m http.server 4000 --directory _site
set -euo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# A locale, if the environment has not chosen one.
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-$LANG}"

usable_ruby() { [ -x "$1" ] && "$1" -e 'exit(RUBY_VERSION.split(".")[0].to_i >= 3)' 2>/dev/null; }

# Only reorder PATH if whatever `ruby` currently resolves to is too old.
if ! usable_ruby "$(command -v ruby || true)"; then
    for dir in /opt/homebrew/opt/ruby@3.1/bin /opt/homebrew/bin \
               /usr/local/opt/ruby@3.1/bin /usr/local/opt/ruby/bin; do
        if usable_ruby "$dir/ruby"; then
            export PATH="$dir:$PATH"
            break
        fi
    done
fi

if ! usable_ruby "$(command -v ruby || true)"; then
    echo "bin/serve: no Ruby >= 3.0 found on PATH." >&2
    echo "  Install one (e.g. \`brew install ruby@3.1\`), then re-run." >&2
    echo "  Current: $(ruby -v 2>/dev/null || echo 'no ruby at all')" >&2
    exit 1
fi

if ! bundle check >/dev/null 2>&1; then
    echo "bin/serve: installing gems into vendor/bundle (first run only)…" >&2
    bundle config set --local path vendor/bundle >/dev/null
    bundle install
fi

# Assume `serve` unless the caller named a subcommand. So `bin/serve`,
# `bin/serve --port 5000`, `bin/serve build`, and `bin/serve serve --watch`
# all do the sensible thing.
if [ "$#" -eq 0 ] || [ "${1#-}" != "$1" ]; then
    set -- serve "$@"
fi

exec bundle exec jekyll "$@"
