# Jekyll build output & caches
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Local bundler install. Gemfile.lock is deliberately untracked: GitHub Pages
# builds with its own pinned `github-pages` gem and never reads ours, so the
# lock only ever describes one contributor's local resolution — and it pins a
# bundler version, which is what makes a machine with an older bundler fail
# outright rather than just resolve afresh.
vendor/
.bundle/
Gemfile.lock

# OS cruft
.DS_Store

.gems/

# Python bytecode
__pycache__/
*.pyc

# Local working notes (kept out of the public repo by convention)
docs/

# Design-review scratch pages: kept locally (they can be served via bin/serve
# for reference) but deliberately not published. See docs/decisions-brief.md.
review/
